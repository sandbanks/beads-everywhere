package components

import (
	"fmt"
	"beads-fleet/pkg/models"
)

templ IssueCard(issue models.Issue) {
	<div
		id={ fmt.Sprintf("issue-card-%s", issue.ID) }
		class="group relative rounded-2xl bg-zinc-900/60 border border-zinc-800/80 hover:border-zinc-700/80 p-4 sm:p-5 shadow-lg transition-all duration-200 hover:shadow-xl hover:shadow-black/40 flex flex-col justify-between"
	>
		<div>
			<!-- Top Meta Row -->
			<div class="flex items-center justify-between gap-2 mb-2.5 sm:mb-3">
				<div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
					<!-- Project Badge -->
					<a
						href={ templ.SafeURL(fmt.Sprintf("/?repo=%s", issue.Project)) }
						class="text-[11px] font-semibold px-2 py-0.5 rounded-md bg-indigo-950/60 text-indigo-300 border border-indigo-800/50 hover:bg-indigo-900/60 transition-colors"
					>
						📁 { issue.Project }
					</a>

					<span class="font-mono text-xs text-zinc-500">{ issue.ID }</span>

					<span class={ "text-xs font-semibold px-2 py-0.5 rounded-full border", issue.PriorityBadgeClass() }>
						{ issue.PriorityLabel() }
					</span>

					<span class="text-xs px-2 py-0.5 rounded-md bg-zinc-800/60 text-zinc-400 border border-zinc-700/40 font-mono">
						{ issue.IssueType }
					</span>
				</div>

				<!-- Status Badge -->
				<div class="flex items-center gap-1">
					if issue.Status == "in_progress" {
						<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
							<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
							In Progress
						</span>
					} else if issue.Status == "closed" {
						<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-zinc-800 text-zinc-500 border border-zinc-700/50">
							Closed
						</span>
					} else {
						<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/30">
							Ready
						</span>
					}
				</div>
			</div>

			<!-- Title -->
			<h3 class={ "text-base font-semibold tracking-tight text-zinc-100 group-hover:text-indigo-200 transition-colors", templ.KV("line-through text-zinc-500", issue.Status == "closed") }>
				{ issue.Title }
			</h3>

			<!-- Description -->
			if issue.Description != "" && issue.Description != issue.Title {
				<p class="mt-2 text-sm text-zinc-400 leading-relaxed line-clamp-3">
					{ issue.Description }
				</p>
			}
		</div>

		<!-- Action Bar (Footer) -->
		<div class="mt-4 sm:mt-5 pt-3 border-t border-zinc-800/60 flex items-center justify-between gap-2">
			<!-- Quick Status Toggle -->
			<div class="flex items-center gap-1.5">
				if issue.Status == "open" {
					<button
						hx-post={ fmt.Sprintf("/issues/%s/status?status=in_progress", issue.ID) }
						hx-target={ fmt.Sprintf("#issue-card-%s", issue.ID) }
						hx-swap="outerHTML"
						class="text-xs px-3 py-1.5 sm:px-2.5 sm:py-1 rounded-lg sm:rounded-md bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 transition-colors font-medium"
						title="Claim issue into in_progress"
					>
						Claim 🚀
					</button>
					<button
						hx-post={ fmt.Sprintf("/issues/%s/status?status=closed", issue.ID) }
						hx-target={ fmt.Sprintf("#issue-card-%s", issue.ID) }
						hx-swap="outerHTML"
						class="text-xs px-3 py-1.5 sm:px-2 py-1 rounded-lg sm:rounded-md bg-zinc-800/60 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 border border-zinc-700/40 transition-colors"
						title="Mark completed"
					>
						Done ✓
					</button>
				} else if issue.Status == "in_progress" {
					<button
						hx-post={ fmt.Sprintf("/issues/%s/status?status=closed", issue.ID) }
						hx-target={ fmt.Sprintf("#issue-card-%s", issue.ID) }
						hx-swap="outerHTML"
						class="text-xs px-3 py-1.5 sm:px-2.5 sm:py-1 rounded-lg sm:rounded-md bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-300 border border-indigo-500/40 font-medium transition-colors"
						title="Complete issue"
					>
						Complete ✓
					</button>
					<button
						hx-post={ fmt.Sprintf("/issues/%s/status?status=open", issue.ID) }
						hx-target={ fmt.Sprintf("#issue-card-%s", issue.ID) }
						hx-swap="outerHTML"
						class="text-xs px-3 py-1.5 sm:px-2 py-1 rounded-lg sm:rounded-md bg-zinc-800/60 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 border border-zinc-700/40 transition-colors"
						title="Unclaim back to Ready"
					>
						Unclaim
					</button>
				} else {
					<button
						hx-post={ fmt.Sprintf("/issues/%s/status?status=open", issue.ID) }
						hx-target={ fmt.Sprintf("#issue-card-%s", issue.ID) }
						hx-swap="outerHTML"
						class="text-xs px-2 py-1 rounded-md bg-zinc-800/60 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 border border-zinc-700/40 transition-colors"
						title="Reopen issue"
					>
						Reopen ↺
					</button>
				}
			</div>

			<!-- Terminal Copy & Delete -->
			<div class="flex items-center gap-1.5">
				<button
					type="button"
					onclick={ templ.ComponentScript{Call: fmt.Sprintf("navigator.clipboard.writeText('cd %s && br show %s')", issue.ProjectPath, issue.ID)} }
					class="p-1.5 text-zinc-500 hover:text-zinc-300 rounded transition-colors"
					title="Copy terminal command (cd & br show)"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
					</svg>
				</button>

				<button
					hx-delete={ fmt.Sprintf("/issues/%s", issue.ID) }
					hx-target={ fmt.Sprintf("#issue-card-%s", issue.ID) }
					hx-swap="outerHTML"
					hx-confirm="Are you sure you want to delete this issue?"
					class="p-1.5 text-zinc-600 hover:text-rose-400 rounded transition-colors"
					title="Delete issue"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
}
