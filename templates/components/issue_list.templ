package components

import "beads-fleet/pkg/models"

templ IssueList(issues []models.Issue) {
	<div id="issues-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
		if len(issues) == 0 {
			<div class="col-span-full py-16 text-center rounded-2xl border border-dashed border-zinc-800 bg-zinc-900/30">
				<span class="text-3xl">✨</span>
				<h3 class="mt-3 text-sm font-semibold text-zinc-300">No issues found</h3>
				<p class="mt-1 text-xs text-zinc-500">All clear or try changing your filters.</p>
			</div>
		} else {
			for _, issue := range issues {
				@IssueCard(issue)
			}
		}
	</div>
}
